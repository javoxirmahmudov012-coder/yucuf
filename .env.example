# ============================================================
#  UZRETRO.UZ — .env.example
#  Ushbu faylni nusxa olib ".env" deb saqlang va
#  haqiqiy qiymatlarni kiriting.
#  HECH QACHON .env faylini GitHub ga yuklamang!
# ============================================================

# Xavfsizlik kaliti (tasodifiy uzun satr)
SECRET_KEY=your_very_strong_random_secret_key_here

# Admin panel kirish
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_password_here

# Sayt domenini (to'lov return_url uchun)
SITE_URL=https://uzretro.uz

# Payme sozlamalari (merchant.payme.uz dan oling)
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_KEY=your_payme_secret_key
PAYME_TEST_MODE=false

# Click sozlamalari (my.click.uz dan oling)
CLICK_SERVICE_ID=your_click_service_id
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SECRET_KEY=your_click_secret_key

# Telegram Bot (BotFather dan oling)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_ADMIN_CHAT_ID=your_chat_id_here

# Yetkazib berish tariflari (so'mda, ixtiyoriy)
DELIVERY_TASHKENT_PRICE=25000
DELIVERY_REGIONS_PRICE=40000
DELIVERY_EXPRESS_PRICE=45000
FREE_DELIVERY_THRESHOLD=300000
